# Optional. Leave empty to disable W&B.
WANDB_API_KEY=
WANDB_PROJECT=nimbus-support-llm

# Hugging Face (only needed to pull gated models such as Llama)
HF_TOKEN=

# Serve
NIMBUS_API_KEY=dev-local-key
NIMBUS_BACKEND=transformers
NIMBUS_MODEL=sshleifer/tiny-gpt2
NIMBUS_ADAPTER=
NIMBUS_HOST=0.0.0.0
NIMBUS_PORT=8000
VLLM_BASE_URL=http://127.0.0.1:8001/v1

# Cache location if you want weights off the repo disk
# HF_HOME=.cache/huggingface
